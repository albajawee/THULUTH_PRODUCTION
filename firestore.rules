rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: document belongs to authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Never delete user profiles

      // Funds — readable & server-updated only
      match /funds/{fundId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only server (Admin SDK) writes funds
      }

      // Incomes — append only via server
      match /incomes/{incomeId} {
        allow read: if isOwner(userId);
        allow write: if false; // Server Actions only
      }

      // Transactions — IMMUTABLE: read only, no client writes
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false; // Append-only via server, never update/delete
      }

      // Expenses — read only (written by server)
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Expense stats — maintained rollups, read only (written by server)
      match /expense_stats/{fundId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Goals — read only (written by server)
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Donations — read only
      match /donations/{donationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Transfers — read only
      match /transfers/{transferId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Audit logs — read only, never writable by client
      match /audit_logs/{logId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
